{
  "$defs": {
    "cycle": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "additionalProperties": false,
          "properties": {
            "ads": {
              "$ref": "#/$defs/step"
            },
            "blow": {
              "$ref": "#/$defs/step"
            },
            "cool": {
              "$ref": "#/$defs/step"
            },
            "heat": {
              "$ref": "#/$defs/step"
            },
            "press": {
              "$ref": "#/$defs/step"
            },
            "s_des": {
              "$ref": "#/$defs/step"
            },
            "s_purge": {
              "$ref": "#/$defs/step"
            },
            "startup": {
              "$ref": "#/$defs/step"
            },
            "w_des": {
              "$ref": "#/$defs/step"
            },
            "w_purge": {
              "$ref": "#/$defs/step"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "compute_numerical_sparsity": {
          "type": "boolean"
        },
        "css_probe_step": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "css_tolerance": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "cvode_sparsity_mode": {
          "enum": [
            "pde_only",
            "full"
          ]
        },
        "cycle_options": {
          "additionalProperties": true,
          "type": "object"
        },
        "cycle_steps": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra_tag": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generate_kpi_outputs": {
          "type": "boolean"
        },
        "keep_only_final_cycle": {
          "type": "boolean"
        },
        "max_cycles": {
          "minimum": 1,
          "type": "integer"
        },
        "output_root": {
          "minLength": 1,
          "type": "string"
        },
        "plot_cyclic_profiles": {
          "type": "boolean"
        },
        "plot_final_cycle_profiles": {
          "type": "boolean"
        },
        "plot_format": {
          "minLength": 1,
          "type": "string"
        },
        "plot_profiles": {
          "type": "boolean"
        },
        "print_cycle_build": {
          "type": "boolean"
        },
        "print_to_terminal": {
          "type": "boolean"
        },
        "require_css": {
          "type": "boolean"
        },
        "resume_from_cycle": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "solve": {
          "type": "boolean"
        },
        "step_options": {
          "additionalProperties": true,
          "type": "object"
        },
        "termination_mode": {
          "anyOf": [
            {
              "enum": [
                "time",
                "event"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "use_sparsity": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "simulation": {
      "additionalProperties": false,
      "properties": {
        "adsorption": {
          "additionalProperties": false,
          "properties": {
            "equilibrium_systems": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "datasets": {
                    "additionalProperties": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "parameters": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": [
                  "datasets",
                  "parameters"
                ],
                "type": "object"
              },
              "description": "Equilibrium systems keyed by explicit registry model name.",
              "minProperties": 1,
              "type": "object"
            },
            "kinetics": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "parameters": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": [
                  "model",
                  "parameters"
                ],
                "type": "object"
              },
              "description": "One kinetic model per adsorbate, keyed by species name.",
              "minProperties": 1,
              "type": "object"
            }
          },
          "type": "object"
        },
        "bed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "architecture": {
                  "enum": [
                    "packed_bed"
                  ]
                },
                "design": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "material": {
                  "type": "null"
                }
              },
              "type": "object"
            },
            {
              "enum": [
                "packed_bed_default"
              ],
              "type": "string"
            }
          ]
        },
        "cycle": {
          "$ref": "#/$defs/cycle"
        },
        "geometry": {
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Length over diameter, L/D; an input with specified_by=volume_aspect_ratio."
            },
            "length_m": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bed length; an input with specified_by=length_radius."
            },
            "radius_m": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bed radius; an input with specified_by=length_radius."
            },
            "specified_by": {
              "description": "Which pair gives the column size: volume_m3 and aspect_ratio, or length_m and radius_m. The other pair is computed; leave it null.",
              "enum": [
                "volume_aspect_ratio",
                "length_radius"
              ]
            },
            "volume_m3": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bed volume; an input with specified_by=volume_aspect_ratio."
            }
          },
          "type": "object"
        },
        "grid": {
          "additionalProperties": false,
          "properties": {
            "nr": {
              "minimum": 1,
              "type": "integer"
            },
            "nr_plot_2d": {
              "minimum": 1,
              "type": "integer"
            },
            "nt": {
              "minimum": 1,
              "type": "integer"
            },
            "nz": {
              "minimum": 1,
              "type": "integer"
            },
            "output_schedule": {
              "additionalProperties": false,
              "properties": {
                "dense_start_points": {
                  "anyOf": [
                    {
                      "minimum": 2,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dense_start_s": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "first_output_s": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_output_spacing_s": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "mixture": {
          "additionalProperties": false,
          "properties": {
            "adsorbates": {
              "description": "Ordered adsorbing subset of the gas mixture.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "closure_species": {
              "description": "Species reconstructed by concentration closure.",
              "minLength": 1,
              "type": "string"
            },
            "species": {
              "description": "Ordered gas species. Molecular constants come from the species catalog.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "reference": {
          "additionalProperties": false,
          "properties": {
            "co2_mole_fraction": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "pressure_Pa": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "relative_humidity": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "temperature_K": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "velocity_m_s": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "solver": {
          "additionalProperties": false,
          "properties": {
            "atol": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "atol_scalar_energy": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "atol_scalar_mass": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "rtol": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "sorbent": {
          "additionalProperties": false,
          "properties": {
            "conductivity_W_mK": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "density_kg_m3": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "fixed_adsorbates": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "heat_capacity_J_molK": {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "loading_mol_per_kg": {
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "loading_mol_per_kg",
                  "heat_capacity_J_molK"
                ],
                "type": "object"
              },
              "description": "Non-exchanging loadings keyed by species (any case: n2 = N2): they add heat capacity to the solid and take no part in the mass balance.",
              "type": "object"
            },
            "heat_capacity": {
              "additionalProperties": false,
              "description": "Solid heat capacity: `Low2023` (a_J_K_per_kg, b_J_per_kgK2, c_J_per_kgK; evaluated at the step feed temperature) or `constant` (value_J_kgK).",
              "properties": {
                "model": {
                  "minLength": 1,
                  "type": "string"
                },
                "parameters": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "type": "object"
                }
              },
              "required": [
                "model",
                "parameters"
              ],
              "type": "object"
            },
            "heats_of_adsorption_J_mol": {
              "additionalProperties": {
                "type": "number"
              },
              "description": "Heat of adsorption [J/mol] of each adsorbate, keyed by species name (any case: co2 = CO2); negative (exothermic); every species of mixture.adsorbates needs one, others are ignored.",
              "minProperties": 1,
              "type": "object"
            },
            "particle_radius_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "pore_radius_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "porosity": {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "wall": {
          "additionalProperties": false,
          "properties": {
            "bed_wall_htc_override_W_m2K": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "conductivity_W_mK": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "density_kg_m3": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "overall_htc_override_W_m2K": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "specific_heat_J_kgK": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "thickness_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "properties": {
        "composition": {
          "additionalProperties": false,
          "properties": {
            "co2_feed_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "co2_initial_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "initial_relative_humidity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "initial_solid_loadings_mol_per_kg": {
              "anyOf": [
                {
                  "additionalProperties": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "minProperties": 1,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Initial solid loading [mol/kg] of each adsorbate, keyed by species name (any case: co2 = CO2), the same in the whole bed; every species of mixture.adsorbates needs its own value, others are refused; startup only. null equilibrates the solid with the initial gas."
            },
            "n2_feed_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "n2_initial_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "o2_feed_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "o2_initial_mole_fraction": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "relative_humidity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "flow": {
          "additionalProperties": false,
          "properties": {
            "ads_outlet_overpressure_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One-way outlet pressure rise at nominal feed velocity [Pa]; 1D ads/startup only."
            },
            "blowdown_valve_conductance": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Valve conductance alpha [1/m] of the outlet relation dp/dn = alpha (p_set - p), n the outward normal; null is an ideal valve. Not read with vacuum_outlet_model 'vacuum_pump'."
            },
            "feed_blower_band_fraction": {
              "anyOf": [
                {
                  "maximum": 0.1,
                  "minimum": 1e-06,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Throttle width / feed pressure in [1e-6, 0.1]; null uses 1e-3 after inheritance."
            },
            "feed_blower_flow_m3_s": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Supply volumetric capacity at this step's feed pressure and temperature [m3/s]; required with feed_blower. Absolute: not coupled automatically to ads flow."
            },
            "press_inlet_model": {
              "description": "Press inlet: valve (default), or capacity-limited feed_blower (1D press only).",
              "enum": [
                "valve",
                "feed_blower"
              ]
            },
            "pressurization_valve_conductance": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Valve conductance alpha [1/m] of the inlet relation dp/dn = alpha (p_set - p), n the outward normal; null is an ideal valve. Not read with press_inlet_model 'feed_blower'."
            },
            "steam_mass_flow_kg_s": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vacuum_outlet_model": {
              "description": "Outlet of a vacuum-connected step (blow, heat, w_purge, w_des): 'valve' to a vacuum reservoir at the outlet pressure (blowdown_valve_conductance), or 'vacuum_pump', a pump of finite speed with pressure control at the outlet pressure (1D only; blowdown_valve_conductance is then not read).",
              "enum": [
                "valve",
                "vacuum_pump"
              ]
            },
            "vacuum_pump_idle_mode": {
              "anyOf": [
                {
                  "enum": [
                    "off",
                    "minimum_speed",
                    "fixed_speed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the vacuum pump draws while the pressure control holds it without removing gas: 'off' (on/off with an isolation valve, no standby power), 'minimum_speed' (variable-speed drive at its minimum speed) or 'fixed_speed' (fixed-speed pump running against the closed control valve). A resolved null uses 'off'. An explicit null in a preset or setting inherits the lower layer; it does not reset an inherited mode."
            },
            "vacuum_pump_idle_power_W": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Standby electric power P_idle [W] of the vacuum pump, charged as P_idle (1 - g) while the control throttles; the vendor's absorbed power at minimum speed or at the ultimate pressure. Required with vacuum_pump_idle_mode 'minimum_speed' or 'fixed_speed', null otherwise."
            },
            "vacuum_pump_speed_m3_s": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Asymptotic volumetric speed S0 [m3/s] of the vacuum pump, S(p) = S0 (1 - p_ult/p); required with vacuum_outlet_model 'vacuum_pump'."
            },
            "vacuum_pump_ultimate_pressure_Pa": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ultimate pressure p_ult [Pa] of the vacuum pump, nonnegative and below the outlet pressure. A resolved null uses 0 Pa. An explicit null in a preset or setting inherits the lower layer; it does not reset an inherited value."
            },
            "vacuum_setpoint_band_fraction": {
              "anyOf": [
                {
                  "maximum": 0.1,
                  "minimum": 1e-06,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Width of the control's throttle band divided by the outlet-pressure setpoint, in [1e-6, 0.1]: closed at the setpoint and fully open at or above setpoint * (1 + band). A resolved null uses 0.001. An explicit null in a preset or setting inherits the lower layer; it does not reset an inherited value."
            },
            "volumetric_flow_m3_s": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "horizon": {
          "additionalProperties": false,
          "properties": {
            "event_max_time_s": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nominal_time_s": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "outlet": {
          "additionalProperties": false,
          "properties": {
            "collect_product": {
              "description": "Send the step outlet to the product line (condenser, vacuum pump, vacuum-discharge flash); false vents it.",
              "type": "boolean"
            },
            "condenser": {
              "description": "Put a condenser before the vacuum pump of a collected step.",
              "type": "boolean"
            },
            "condenser_temperature_K": {
              "description": "Temperature the condenser cools the collected stream to.",
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "pressure": {
          "additionalProperties": false,
          "properties": {
            "ambient_pressure_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feed_pressure_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "initial_pressure_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outlet_pressure_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "termination": {
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "above",
                "below"
              ]
            },
            "label": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "low_pressure_stop_Pa": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
